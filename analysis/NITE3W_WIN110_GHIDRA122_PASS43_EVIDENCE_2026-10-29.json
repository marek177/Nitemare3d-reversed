    "scripts/verify_pass43_builder_map.py": "import csv,json,struct,hashlib,itertools\nfrom pathlib import Path\nfrom unicorn import *\nfrom unicorn.x86_const import *\nR=Path(__file__).resolve().parents[1];b=(R/'prior/inputs/nite3w - 110.exe').read_bytes();assert hashlib.sha256(b).hexdigest()=='12fe5168783446275802e0e947898261b5eca6b88288f3a895fc1faa4c544481'\nrows=[r for r in csv.DictReader((R/'pass42-results/listing.tsv').open(),delimiter='\\t') if r['function'] in ['1010:6266','1010:6152','1010:b1a4','1010:2aac','1018:3736']];codes={3:bytearray(b[0x15fc0:0x15fc0+0xefbc]),4:bytearray(b[0x25260:0x25260+0x563c])};rels=[]\nfor r in json.loads((R/'pass2/relocation_chain_sites.json').read_text()):\n if any(int(x['address'].split(':')[1],16)<=r['source']<int(x['address'].split(':')[1],16)+len(x['bytes'])//2 and int(x['address'].split(':')[0],16)==0x1000+8*(r['source_segment']-1) for x in rows):\n  assert r['type']==2 and r['flags']==0;struct.pack_into('<H',codes[r['source_segment']],r['source'],0x1000+8*(r['target_segment']-1));rels.append(r)\nfor r in rows:\n seg,a=r['address'].split(':');a=int(a,16);code=codes[3 if seg=='1010' else 4];assert code[a:a+len(r['bytes'])//2].hex()==r['bytes']\n(R/'pass43/integrated_listing.tsv').write_text('address\\tbytes\\tinstruction\\tfunction\\n'+''.join('\\t'.join(r[k] for k in ['address','bytes','instruction','function'])+'\\n' for r in rows))\nCS=0x2000;DS=0x1048;D=DS<<4;sel={3:CS,4:0x4000,6:0x6000}\nfor r in rels:\n if r['target_segment'] in sel:struct.pack_into('<H',codes[r['source_segment']],r['source'],sel[r['target_segment']])\nu=Uc(UC_ARCH_X86,UC_MODE_16);u.mem_map(0,0x100000)\nfor r in rows:\n seg,a=r['address'].split(':');a=int(a,16);n=len(r['bytes'])//2;k=3 if seg=='1010' else 4;u.mem_write((sel[k]<<4)+a,bytes(codes[k][a:a+n]))\nu.mem_write((CS<<4)+0xb1c0,bytes(codes[3][0xb1c0:0xb1d4]));patterns=[p for n in range(1,9) for p in itertools.product([0,1],repeat=n)];cases=0\nfor pattern,flags,orientation in itertools.product(patterns,[0,8],range(4)):\n ptrs=[(0x1000+32*k,0x5000) for k in pattern];mapexpected=bytearray(b'\\xa5'*4096)\n for k in set(pattern):\n  x=2+2*k;y=2;xx=x;yy=5;obj=bytearray(28);obj[5]=flags;obj[7]=orientation;struct.pack_into('<4H',obj,12,x*64+31,y*64+17,xx*64+31,yy*64+17);struct.pack_into('<4H',obj,20,10,1400,20,1400);u.mem_write(0x50000+0x1000+32*k,bytes(obj))\n  if flags&8:mapexpected[x*64+y]=99\n  else:\n   if orientation==2:x-=1;xx=x\n   if orientation==1:y-=1;yy=y\n   if x==xx:\n    for j in range(y,yy):mapexpected[x*64+j]=42\n   else:\n    for j in range(x,xx):mapexpected[j*64+y]=42\n runs=[]\n for i,p in enumerate(ptrs):\n  if not runs or runs[-1][0]!=p:runs.append([p,10+i,10+i])\n  else:runs[-1][2]=10+i\n for reg,v in [(UC_X86_REG_CS,CS),(UC_X86_REG_DS,DS),(UC_X86_REG_SS,DS),(UC_X86_REG_SP,0xd000),(UC_X86_REG_BP,0xe000),(UC_X86_REG_EFLAGS,2)]:u.reg_write(reg,v)\n u.mem_write(D+0x53e4,struct.pack('<2H',10,9+len(ptrs)));u.mem_write(D+0x53f0,struct.pack('<H',1280));u.mem_write(D+0x53fe+40,b''.join(struct.pack('<2H',*p) for p in ptrs));u.mem_write(D+0x5e88,b'\\xa5'*(10*20));u.mem_write(0x60000,b'\\xa5'*4096);u.mem_write(D+0x222c,struct.pack('<H',0x6000));u.mem_write(D+0xc4,b'\\0');u.mem_write(D+0x3280,b'\\x2a');u.mem_write(D+0x3287,b'\\x63');u.mem_write(D+0xd000,struct.pack('<HH',0xf000,CS));u.emu_start((CS<<4)+0x6266,(CS<<4)+0xf000,count=20000)\n expected=bytearray(b'\\xa5'*200)\n for i,(p,start,end) in enumerate(runs):struct.pack_into('<10H',expected,20*i,*p,start,1400,end,1400,0,0,0,120)\n assert bytes(u.mem_read(D+0x5e88,200))==expected and bytes(u.mem_read(0x60000,4096))==mapexpected\n assert int.from_bytes(u.mem_read(D+0x5e7e,2),'little')==len(runs)\n assert u.reg_read(UC_X86_REG_SP)==0xd004 and u.reg_read(UC_X86_REG_BP)==0xe000 and u.reg_read(UC_X86_REG_DS)==DS;cases+=1\nout=dict(cases=cases,original_functions=['6266','6152','B1A4 mode0','3736','2AAC cached'],stubs=[],instruction_checks=len(rows),record_bytes_compared=200,map_bytes_compared=4096,full_game_runtime=False,limits=['Nonzero2objectpointerpatterns length1..8,flatprojectedendpoints','Cachedpaletteonly;actualpalettebuildexcluded','MAXSEGboundaryexcluded;actualWin16mappingnotexecuted'])\n(R/'pass43/integrated_verification.json').write_text(json.dumps(out,indent=2)+'\\n');print(out)\n",
