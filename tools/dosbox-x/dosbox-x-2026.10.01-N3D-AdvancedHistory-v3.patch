+/* Nitemare 3D trace extension for DOSBox-X Heavy Debug.
+ * RE tool. Outputs guest CPU pre-state and observable memory/IO/INT events.
+ * Does not claim coverage of device/DMA accesses that bypass mem_*_inline.
+ */
+#ifndef DOSBOX_N3D_TRACE_H
+#define DOSBOX_N3D_TRACE_H
+#include <atomic>
+#include <cstdint>
+#if C_HEAVY_DEBUG
+extern std::atomic<bool> n3d_trace_mem_enabled;
+extern std::atomic<bool> n3d_trace_read_enabled;
+extern std::atomic<bool> n3d_trace_io_enabled;
+extern std::atomic<bool> n3d_trace_vram_enabled;
+extern std::atomic<bool> n3d_trace_vframe_enabled;
+extern std::atomic<bool> n3d_trace_vreg_enabled;
+extern std::atomic<bool> n3d_trace_rgb_enabled;
+void N3DTrace_VGARegisters(uint32_t reason_port); // post-IO VGA register snapshot
+void N3DTrace_VGARegistersWatch(bool enabled);
+void N3DTrace_RenderFrame(void); // source RGB pixels sampled at RENDER_EndUpdate
+void N3DTrace_RenderPeriod(uint32_t period);
+// Independent host VRAM write observation; reports actual host-VRAM byte offset, not CPU linear address.
+void N3DTrace_VRAMWrite(uint32_t offset, uint32_t old_value, uint32_t new_value, uint8_t width, uint8_t source);
+void N3DTrace_VRAMDirectWrite(const void* host_ptr, uint32_t old_value, uint32_t new_value, uint8_t width);
+void N3DTrace_VGAFrame(void); // called at the emulated VGA vertical timer
+bool N3DTrace_VGASnapshot(void); // raw VRAM + DAC, only when trace is active
+void N3DTrace_VGAInfo(void);
+void N3DTrace_VRAMWatch(bool enabled);
+void N3DTrace_FrameWatch(uint32_t period); // 0 disables
+
+void N3DTrace_Memory(char type, uint32_t addr, uint32_t value, uint32_t old_value, uint8_t width, bool old_valid);
+void N3DTrace_IO(bool write, uint32_t port, uint32_t value, uint8_t width);
+void N3DTrace_INT(uint32_t vector, uint32_t type, uint32_t old_ip);
+void N3DTrace_Init(void);
+bool N3DTrace_Instruction(void); // true = breakpoint requested at configured stop CS:IP
+bool N3DTrace_Start(void);
+void N3DTrace_Stop(void);
+void N3DTrace_Status(void);
+#endif
+#endif
